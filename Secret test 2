local function createIntestineCoils(parent,baseCFrame)
	for i=1,5 do
		local coil=Instance.new("Part")
		coil.Name="IntestineCoil"..i
		coil.Size=Vector3.new(.4,.4,1.4)
		coil.Color=Color3.fromRGB(170+math.random(-15,15),110,95)
		coil.Material=Enum.Material.SmoothPlastic
		coil.CanCollide=false
		coil.CFrame=baseCFrame*CFrame.new(math.random(-25,25)/100,math.random(-25,25)/100,0)*CFrame.Angles(0,math.rad(i*72),0)
		coil.Parent=parent
	end
end

local function createBloodSpray(part,intensive)
	local att=Instance.new("Attachment",part)
	local spray=Instance.new("ParticleEmitter")
	spray.Texture="rbxasset://textures/particles/smoke_main.dds"
	spray.Color=ColorSequence.new(Color3.fromRGB(120,0,0))
	spray.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.4),NumberSequenceKeypoint.new(1,.15)})
	spray.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.2),NumberSequenceKeypoint.new(1,1)})
	spray.Lifetime=NumberRange.new(1,2.5)
	spray.Rate=intensive and 120 or 60
	spray.Speed=NumberRange.new(12,25)
	spray.SpreadAngle=Vector2.new(50,50)
	spray.Acceleration=Vector3.new(0,-25,0)
	spray.Enabled=false
	spray.Parent=att
	return spray
end

local function createBloodPool(position)
	local pool=Instance.new("Part")
	pool.Name="BloodPool"
	pool.Size=Vector3.new(5,.05,5)
	pool.CFrame=CFrame.new(position.X,position.Y-2.8,position.Z)
	pool.Material=Enum.Material.SmoothPlastic
	pool.Color=Color3.fromRGB(80,0,0)
	pool.Transparency=.25
	pool.CanCollide=false
	pool.Anchored=true
	pool.Parent=W
	spawn(function()
		for i=1,30 do
			pool.Size=Vector3.new(5+i*.15,.05,5+i*.15)
			pool.Transparency=.25+(i*.02)
			task.wait(.1)
		end
	end)
	D:AddItem(pool,60)
end

local function getMainTorso(char)
	return char:FindFirstChild("Torso")or char:FindFirstChild("UpperTorso")or char:FindFirstChild("HumanoidRootPart")
end

local function buildAnatomy(char)
	if char:FindFirstChild("Anatomy")then return end
	local torso=getMainTorso(char)
	local head=char:FindFirstChild("Head")
	if not torso then return end
	local anatomyFolder=Instance.new("Folder")
	anatomyFolder.Name="Anatomy"
	anatomyFolder.Parent=char
	for organName,config in pairs(ANATOMY)do
		local parentPart=config.Parent=="Head"and head or torso
		if not parentPart then continue end
		local organ=Instance.new("Part")
		organ.Name=organName
		organ.Size=config.Size
		organ.Color=config.Color
		organ.Material=config.Material
		organ.Transparency=config.Transparency or 0
		organ.CanCollide=false
		organ.Anchored=false
		organ.CFrame=parentPart.CFrame*config.Offset
		if config.Shape then organ.Shape=config.Shape end
		local weld=Instance.new("WeldConstraint")
		weld.Part0=organ
		weld.Part1=parentPart
		weld.Parent=organ
		if config.Coiled then
			createIntestineCoils(anatomyFolder,organ.CFrame)
			organ:Destroy()
		else
			organ.Parent=anatomyFolder
		end
		createBloodSpray(organ,organName=="Heart")
	end
	return anatomyFolder
end

local function explodeGore(char)
	local anatomyFolder=char:FindFirstChild("Anatomy")
	local torso=getMainTorso(char)
	if not anatomyFolder or not torso then return end
	createBloodPool(torso.Position)
	for _,organ in pairs(anatomyFolder:GetChildren())do
		if not organ:IsA("BasePart")then continue end
		for _,weld in pairs(organ:GetChildren())do
			if weld:IsA("WeldConstraint")then weld:Destroy()end
		end
		organ.CanCollide=true
		organ.Anchored=false
		local bv=Instance.new("BodyVelocity")
		bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
		bv.Velocity=Vector3.new(math.random(-45,45),math.random(25,70),math.random(-45,45))
		bv.Parent=organ
		D:AddItem(bv,.35)
		local spray=organ:FindFirstChild("Attachment")and organ.Attachment:FindFirstChildOfClass("ParticleEmitter")
		if spray then
			spray.Enabled=true
			task.delay(5,function()if spray then spray.Enabled=false end end)
		end
		D:AddItem(organ,50)
	end
end

local function setupCharacter(char)
	if not char then return end
	if not char:FindFirstChildOfClass("Humanoid")then return end
	
	task.wait(0.5)
	buildAnatomy(char)
	
	local humanoid=char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local deathConnection
		deathConnection=humanoid.Died:Connect(function()
			task.wait(0.1)
			explodeGore(char)
			if deathConnection then deathConnection:Disconnect()end
		end)
		
		local healthConnection
		healthConnection=humanoid.HealthChanged:Connect(function(health)
			if health<=0 then
				task.wait(0.1)
				explodeGore(char)
				if healthConnection then healthConnection:Disconnect()end
			end
		end)
	end
	
	char.AncestryChanged:Connect(function(_,parent)
		if not parent then
			local anatomyFolder=char:FindFirstChild("Anatomy")
			if anatomyFolder then
				for _,organ in pairs(anatomyFolder:GetChildren())do
					if organ:IsA("BasePart")then
						D:AddItem(organ,45)
					end
				end
			end
		end
	end)
end

for _,player in pairs(game.Players:GetPlayers())do
