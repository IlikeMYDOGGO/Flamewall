-- Create intestine coils
local function createIntestineCoils(parent, baseCFrame)
	local coils = {}
	for i = 1, 5 do
		local coil = Instance.new("Part")
		coil.Name = "IntestineCoil" .. i
		coil.Size = Vector3.new(0.4, 0.4, 1.4)
		coil.Color = Color3.fromRGB(170 + math.random(-15, 15), 110, 95)
		coil.Material = Enum.Material.SmoothPlastic
		coil.CanCollide = false
		coil.CFrame = baseCFrame * CFrame.new(
			math.random(-25, 25) / 100,
			math.random(-25, 25) / 100,
			0
		) * CFrame.Angles(0, math.rad(i * 72), 0)
		coil.Parent = parent
		table.insert(coils, coil)
	end
	return coils
end

-- Create blood spray particles
local function createBloodSpray(part, intensive)
	local att = Instance.new("Attachment", part)
	
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/smoke_main.dds"
	spray.Color = ColorSequence.new(Color3.fromRGB(120, 0, 0))
	spray.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 0.15)
	})
	spray.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1)
	})
	spray.Lifetime = NumberRange.new(1, 2.5)
	spray.Rate = intensive and 120 or 60
	spray.Speed = NumberRange.new(12, 25)
	spray.SpreadAngle = Vector2.new(50, 50)
	spray.Acceleration = Vector3.new(0, -25, 0)
	spray.Enabled = false
	spray.Parent = att
	
	return spray
end

-- Create blood pool
local function createBloodPool(position)
	local pool = Instance.new("Part")
	pool.Name = "BloodPool"
	pool.Size = Vector3.new(5, 0.05, 5)
	pool.CFrame = CFrame.new(position.X, position.Y - 2.8, position.Z)
	pool.Material = Enum.Material.SmoothPlastic
	pool.Color = Color3.fromRGB(80, 0, 0)
	pool.Transparency = 0.25
	pool.CanCollide = false
	pool.Anchored = true
	pool.Parent = workspace
	
	-- Expand over time
	spawn(function()
		for i = 1, 30 do
			pool.Size = Vector3.new(5 + i * 0.15, 0.05, 5 + i * 0.15)
			pool.Transparency = 0.25 + (i * 0.02)
			task.wait(0.1)
		end
	end)
	
	D:AddItem(pool, 60)
end

-- Build anatomy inside cloned character
local function buildAnatomy(char)
	local torso = char:FindFirstChild("Torso")
	local head = char:FindFirstChild("Head")
	
	if not torso then 
		warn("Not R6 character!")
		return 
	end
	
	local anatomyFolder = Instance.new("Folder")
	anatomyFolder.Name = "Anatomy"
	anatomyFolder.Parent = char
	
	for organName, config in pairs(ANATOMY) do
		local parentPart = config.Parent == "Head" and head or torso
		if not parentPart then continue end
		
		local organ = Instance.new("Part")
		organ.Name = organName
		organ.Size = config.Size
		organ.Color = config.Color
		organ.Material = config.Material
		organ.Transparency = config.Transparency or 0
		organ.CanCollide = false
		organ.Anchored = false
		organ.CFrame = parentPart.CFrame * config.Offset
		
		if config.Shape then
			organ.Shape = config.Shape
		end
		
		-- Weld to parent initially
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = organ
		weld.Part1 = parentPart
		weld.Parent = organ
		
		-- Special handling for intestines
		if config.Coiled then
			createIntestineCoils(anatomyFolder, organ.CFrame)
			organ:Destroy()
		else
			organ.Parent = anatomyFolder
		end
		
		-- Add blood emitter
		createBloodSpray(organ, organName == "Heart")
	end
	
	return anatomyFolder
end

-- Gore explosion effect
local function explodeGore(char)
	local anatomyFolder = char:FindFirstChild("Anatomy")
	local torso = char:FindFirstChild("Torso")
	if not anatomyFolder or not torso then return end
	
	local bloodOrigin = torso.Position
	createBloodPool(bloodOrigin)
	
	-- Release all organs violently
	for _, organ in pairs(anatomyFolder:GetChildren()) do
		if not organ:IsA("BasePart") then continue end
		
		-- Destroy welds
		for _, weld in pairs(organ:GetChildren()) do
			if weld:IsA("WeldConstraint") then
				weld:Destroy()
			end
		end
		
		organ.CanCollide = true
		organ.Anchored = false
		
		-- Explosive force
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(
			math.random(-45, 45),
			math.random(25, 70),
			math.random(-45, 45)
		)
		bv.Parent = organ
		D:AddItem(bv, 0.35)
		
		-- Blood spray
		local spray = organ:FindFirstChild("Attachment") and 
			organ.Attachment:FindFirstChildOfClass("ParticleEmitter")
		if spray then
			spray.Enabled = true
			task.delay(5, function()
				if spray then spray.Enabled = false end
			end)
		end
		
		-- Cleanup
		D:AddItem(organ, 50)
	end
end

-- Create gore clone on enemy death
local function createGoreClone(character)
	if not character or not character:FindFirstChild("Torso") then return end
	
	-- Clone the character
	local clone = character:Clone()
	clone.Name = character.Name .. "_GoreClone"
	
	-- Remove scripts and humanoid
	for _, v in clone:GetDescendants() do
		if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then
			v:Destroy()
		end
	end
	
	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid:Destroy()
	end
	
	-- Make body parts semi-transparent
	local cloneTorso = clone:FindFirstChild("Torso")
	local cloneHead = clone:FindFirstChild("Head")
	
	if cloneTorso then
		cloneTorso.Transparency = 0.65
		cloneTorso.Material = Enum.Material.ForceField
		cloneTorso.Color = Color3.fromRGB(255, 200, 200)
	end
	
	if cloneHead then
		cloneHead.Transparency = 0.65
		cloneHead.Material = Enum.Material.ForceField
		cloneHead.Color = Color3.fromRGB(255, 200, 200)
	end
	
	clone.Parent = workspace
	
	-- Build anatomy
	buildAnatomy(clone)
	
	-- Wait 5 seconds then explode
	task.wait(5)
	explodeGore(clone)
	
	-- Remove clone body parts after explosion
	task.wait(1)
	for _, part in clone:GetChildren() do
		if part:IsA("BasePart") and part.Parent.Name ~= "Anatomy" then
			D:AddItem(part, 5)
		end
	end
	
	-- Final cleanup
	D:AddItem(clone, 55)
end

-- Monitor kills (when you damage someone to death)
local function monitorKills()
	local myChar = P.Character or P.CharacterAdded:Wait()
	
	-- Listen for other players dying
	for _, player in pairs(game.Players:GetPlayers()) do
		if player ~= P then
			player.CharacterAdded:Connect(function(char)
				local humanoid = char:WaitForChild("Humanoid", 5)
				if not humanoid then return end
				
				humanoid.Died:Connect(function()
					-- Check if you were near them (likely your kill)
					if myChar and myChar:FindFirstChild("HumanoidRootPart") then
						local myRoot = myChar.HumanoidRootPart
						local theirRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
						
						if theirRoot and (myRoot.Position - theirRoot.Position).Magnitude < 50 then
							-- Your kill! Create gore clone
							createGoreClone(char)
						end
					end
				end)
			end)
			
			-- Handle existing character
			if player.Character then
				local char = player.Character
				local humanoid = char:FindFirstChild("Humanoid")
				if humanoid then
					humanoid.Died:Connect(function()
						if myChar and myChar:FindFirstChild("HumanoidRootPart") then
							local myRoot = myChar.HumanoidRootPart
							local theirRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
							
							if theirRoot and (myRoot.Position - theirRoot.Position).Magnitude < 50 then
								createGoreClone(char)
							end
						end
					end)
				end
			end
		end
	end
	
	-- Handle new players joining
	game.Players.PlayerAdded:Connect(function(player)
		if player ~= P then
			player.CharacterAdded:Connect(function(char)
				local humanoid = char:WaitForChild("Humanoid", 5)
				if not humanoid then return end
				
				humanoid.Died:Connect(function()
					if myChar and myChar:FindFirstChild("HumanoidRootPart") then
						local myRoot = myChar.HumanoidRootPart
						local theirRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
						
						if theirRoot and (myRoot.Position - theirRoot.Position).Magnitude < 50 then
							createGoreClone(char)
						end
					end
				end)
			end)
		end
	end)
end

